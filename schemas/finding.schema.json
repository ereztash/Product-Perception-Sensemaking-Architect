{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ereztash/Product-Perception-Sensemaking-Architect/schemas/finding.schema.json",
  "title": "Neta Assurance Finding v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "status",
    "raw_signal",
    "candidate_mechanisms",
    "evidence",
    "claims",
    "reversal_condition",
    "next_step"
  ],
  "properties": {
    "contract_version": {"const": "0.2"},
    "status": {"enum": ["DISCRIMINATE_FIRST", "BUILD_READY", "FIELD_STOP"]},
    "raw_signal": {"type": "string", "minLength": 1},
    "candidate_mechanisms": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "explains", "does_not_explain", "discriminator"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "explains": {"type": "string", "minLength": 1},
          "does_not_explain": {"type": "string", "minLength": 1},
          "discriminator": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "description", "reality_level"],
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]+$"},
          "type": {"enum": ["OWNER_SIGNAL", "REPO_MEASUREMENT", "RESEARCH_SOURCE", "ENVIRONMENT_CHECK", "FIELD_OBSERVATION"]},
          "description": {"type": "string", "minLength": 1},
          "reality_level": {"enum": ["R0", "R1", "R2", "R3", "R4", "R5", "R6"]}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "statement",
          "resolution_authority",
          "required_reality",
          "observed_reality",
          "evidence_refs",
          "state",
          "requested_use",
          "permission"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^C[0-9]+$"},
          "kind": {"enum": ["OBSERVATION", "MECHANISM", "INTERVENTION", "OUTCOME"]},
          "statement": {"type": "string", "minLength": 1},
          "resolution_authority": {"enum": ["OWNER", "REPO", "ENVIRONMENT", "RESEARCH", "FIELD"]},
          "required_reality": {"enum": ["R0", "R1", "R2", "R3", "R4", "R5", "R6"]},
          "observed_reality": {"enum": ["R0", "R1", "R2", "R3", "R4", "R5", "R6"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]+$"}},
          "state": {"enum": ["SUPPORTED", "UNRESOLVED", "REFUTED", "INSUFFICIENT_REALITY"]},
          "requested_use": {"enum": ["HYPOTHESIZE", "DISCRIMINATE", "PROTOTYPE", "BUILD_REVERSIBLE", "CHANGE_PRODUCTION", "ASSERT_FIELD_OUTCOME", "DEFER"]},
          "permission": {"enum": ["ALLOW", "DENY", "DEFER"]}
        }
      }
    },
    "design_distinction": {"type": ["string", "null"]},
    "intervention": {"type": ["string", "null"]},
    "must_not_change": {"type": ["string", "null"]},
    "perceptual_success_criterion": {"type": ["string", "null"]},
    "gate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["falsifier", "positive_control"],
      "properties": {
        "falsifier": {"type": "string", "minLength": 1},
        "positive_control": {"type": "string", "minLength": 1}
      }
    },
    "reversal_condition": {"type": "string", "minLength": 1},
    "field_requirement": {"type": ["string", "null"]},
    "waiver": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["accepted_by", "reason", "scope", "revisit"],
      "properties": {
        "accepted_by": {"const": "OWNER"},
        "reason": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "revisit": {"type": "string", "minLength": 1}
      }
    },
    "next_step": {"type": "string", "minLength": 1}
  }
}
